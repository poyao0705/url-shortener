  {
    "id": "table.Url",
    "label": "Create table \"Url\"",
    "summary": "Creates table \"Url\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Url"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Url\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Url\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Url\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Url\"",
        "sql": "CREATE TABLE \"public\".\"Url\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"longUrl\" text NOT NULL,\n  \"shortUrl\" text NOT NULL,\n  \"uid\" text NOT NULL,\n  \"usedCount\" int4 NOT NULL,\n  PRIMARY KEY (\"shortUrl\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Url\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Url\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Url\""
        }
      }
    ]
  }
]