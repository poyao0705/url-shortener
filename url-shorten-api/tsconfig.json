{
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,    
    "target": "esnext",
    "module": "preserve",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": ["src/**/*.ts"]
}
