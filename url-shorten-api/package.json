{
  "type": "module",
  "name": "url-shorten-api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "fastify start -w -l info src/app.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "8.0.0-rc.27",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2"
  }
}