{
  "type": "module",
  "name": "url-shorten-api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 TS_NODE_TRANSPILE_ONLY=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "fastify start -w -l info src/app.ts",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "awilix": "^13.0.5",
    "dotenv": "^18.0.9",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "8.0.0-rc.27",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2"
  }
}