# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_PASSWORD=your_password_here
DATABASE_URL="postgresql://user:your_password_here@localhost:5432/mydb"
REDIS_PASSWORD=your_password_here
REDIS_URL="redis://default:your_password_here@localhost:6379/0"
