# Copy this file to `.env` and replace the placeholder passwords.
# PostgreSQL (requires PostgreSQL >= 15; user and database match compose.yaml)
DATABASE_PASSWORD=your_db_password_here
DATABASE_URL="postgresql://app:your_db_password_here@localhost:5432/url_shortener"

# Redis redirect cache (port 6379, allkeys-lru)
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://default:your_redis_password_here@localhost:6379/0"

# Redis message queue for BullMQ (port 6380, noeviction)
QUEUE_REDIS_PASSWORD=your_queue_redis_password_here
QUEUE_REDIS_URL="redis://default:your_queue_redis_password_here@localhost:6380"
